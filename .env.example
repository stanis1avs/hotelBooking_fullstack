# Скопируйте в .env и заполните своими значениями.
# Файл .env в репозиторий не попадает — см. .gitignore.

# --- MongoDB ---
DB_NAME=hotelbooking
DB_PASSWORD=change-me
MONGO_URI=mongodb://127.0.0.1:27017/nest

# --- Порты ---
SERVER_PORT=7000
CLIENT_PORT=4200

# --- Разрешённые источники для CORS, через запятую ---
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# --- JWT ---
# Два РАЗНЫХ секрета: refresh-токен не должен приниматься как access-токен.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_TOKEN_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
COOKIE_SECRET=change-me-cookie-secret

# Время жизни токенов
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
