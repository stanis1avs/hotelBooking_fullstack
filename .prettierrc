{
  "singleQuote": true,
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "trailingComma": "es5",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "hotelBooking_nest_back/**/*.ts",
      "options": { "singleQuote": false }
    },
    {
      "files": "*.html",
      "options": { "parser": "angular" }
    }
  ]
}
